Z_SCORE_THRESHOLD=3.0
MIN_PRICE_CHANGE_PCT=0.3
MIN_VOLUME_USDT=50000
TOP_N_PAIRS=50
ALERT_COOLDOWN_SEC=300
REFRESH_INTERVAL_SEC=300
